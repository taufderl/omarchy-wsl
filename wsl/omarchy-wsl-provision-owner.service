# WSL adaptation of basecamp/omarchy's install/provisioning/omarchy-provision-owner.service
# (vendored upstream copy at patches/omarchy-provision-owner.service.upstream).
#
# Same gating pattern as upstream: not enabled by anything until the pending
# sentinel exists (armed by wsl/arm-first-boot.sh at image-build time; upstream
# arms the equivalent for its own deferred-provisioning/factory-reset paths).
# Differences from upstream, and why (see docs/install-audit.md):
#   - No `ExecStartPre=-/usr/bin/plymouth quit` — plymouth isn't installed.
#   - No `Before=display-manager.service` / `Conflicts=getty@tty1.service` —
#     sddm isn't installed in v1, so there's no display-manager.service to
#     order against, and no reason to fight getty for tty1 the way upstream
#     does when SDDM is about to claim it.
[Unit]
Description=Omarchy WSL first-boot owner provisioning
ConditionPathExists=/var/lib/omarchy/provisioning/pending

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omarchy-wsl-provision-owner
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
